{
	"compilerOptions": {
		"target": "ES2022",
		"module": "preserve",
		"moduleResolution": "bundler",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"types": [
			"astro/client",
			"node"
		]
	},
	"include": [
		"src/**/*",
		"tests/**/*",
		"types/**/*.d.ts",
		"vitest.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		".astro"
	]
}
