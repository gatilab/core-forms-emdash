 "markup": "<p>\n  <label for=\"cf-name\">Your name <span aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"cf-name\" name=\"name\" autocomplete=\"name\" required aria-required=\"true\" maxlength=\"100\">\n</p>\n<p>\n  <label for=\"cf-email\">Work email <span aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"cf-email\" name=\"email\" autocomplete=\"email\" placeholder=\"you@company.com\" required aria-required=\"true\" maxlength=\"254\">\n</p>\n<p>\n  <label for=\"cf-website\">Current website or project URL</label>\n  <input type=\"url\" id=\"cf-website\" name=\"website\" inputmode=\"url\" placeholder=\"https://example.com\">\n</p>\n<input type=\"hidden\" name=\"service\" value=\"Web Development\">\n<p>\n  <label for=\"cf-project-type\">What do you need built? <span aria-hidden=\"true\">*</span></label>\n  <select id=\"cf-project-type\" name=\"project_type\" required aria-required=\"true\">\n    <option value=\"\">Select the closest match</option>\n    <option value=\"New website build\">New website build</option>\n    <option value=\"Ecommerce store\">Ecommerce store</option>\n    <option value=\"Web application or portal\">Web application or portal</option>\n    <option value=\"Migration or replatform\">Migration or replatform</option>\n    <option value=\"Performance rescue\">Performance rescue</option>\n    <option value=\"Maintenance and support\">Maintenance and support</option>\n    <option value=\"Not sure yet\">Not sure yet</option>\n  </select>\n</p>\n<p>\n  <label for=\"cf-budget\">Approximate budget <span aria-hidden=\"true\">*</span></label>\n  <select id=\"cf-budget\" name=\"budget\" required aria-required=\"true\">\n    <option value=\"\">Select a range</option>\n    <option value=\"Not sure yet\">Not sure yet</option>\n    <option value=\"Under Rs 27,000\">Under Rs 27,000</option>\n    <option value=\"Rs 27,000 to Rs 75,000\">Rs 27,000 to Rs 75,000</option>\n    <option value=\"Rs 75,000 to Rs 2,55,000\">Rs 75,000 to Rs 2,55,000</option>\n    <option value=\"Rs 2,55,000 to Rs 6,00,000\">Rs 2,55,000 to Rs 6,00,000</option>\n    <option value=\"Above Rs 6,00,000\">Above Rs 6,00,000</option>\n  </select>\n</p>\n<p>\n  <label for=\"cf-timeline\">Preferred timeline <span aria-hidden=\"true\">*</span></label>\n  <select id=\"cf-timeline\" name=\"timeline\" required aria-required=\"true\">\n    <option value=\"\">Select a timeline</option>\n    <option value=\"Just exploring\">Just exploring</option>\n    <option value=\"As soon as possible\">As soon as possible</option>\n    <option value=\"Within one month\">Within one month</option>\n    <option value=\"One to three months\">One to three months</option>\n    <option value=\"More than three months\">More than three months</option>\n  </select>\n</p>\n<p>\n  <label for=\"cf-details\">What does the site need to do? <span aria-hidden=\"true\">*</span></label>\n  <textarea id=\"cf-details\" name=\"details\" rows=\"6\" required aria-required=\"true\" maxlength=\"5000\" placeholder=\"Tell us what is not working today, what you need built, and what a successful result looks like.\"></textarea>\n</p>\n<p><button type=\"submit\">Send my project brief</button></p>\n",
