---
/**
 * Portable Text renderer for the "Form" block, and the standalone component:
 *   <CoreForm id="1050302" />  or  <CoreForm slug="contact-form" />
 * Imported WordPress blocks store { formId, formSlug }.
 */
import FormAssets from "./FormAssets.astro";
import { loadForm } from "./load";

interface Props {
	node?: { formId?: string | number | null; formSlug?: string | null };
	id?: string | number;
	slug?: string;
}

const { node, id, slug } = Astro.props;
const result = await loadForm(Astro, { id: id ?? node?.formId, slug: slug ?? node?.formSlug });
---

{
	result && (
		<>
			<Fragment set:html={result.html} />
			<FormAssets captcha={result.captcha ? [result.captcha] : []} />
		</>
	)
}
